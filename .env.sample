ENV=prod

DB_URL=postgresql://refractometer:password@localhost:5432/refractometer-api-gateway
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0

JWT_ALGORITHM="EdDSA"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n\n-----END PUBLIC KEY-----"
JWT_ISSUER="refractometer-api-gateway"
JWT_AUDIENCE="refractometer-backend"

OAUTH_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=
